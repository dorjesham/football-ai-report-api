DATABASE_URL="mysql://user:password@host:3306/football_ai_report"
# 高并发时可在 URL 增加连接池参数（与 MySQL max_connections 协调），例如：
# ?connection_limit=40&pool_timeout=20&connect_timeout=10

NODE_ENV="development"
# 本地常用 3000；未设置时应用默认 8080（与 Sealos 暴露端口一致）
PORT=3000

JWT_SECRET="replace_with_strong_random_secret"
JWT_EXPIRES_IN="30d"

CORS_ORIGIN="*"
# production：须至少一条真实 Origin（禁止 *）。除 CORS_ORIGIN 外还可使用（按优先级）：APP_PUBLIC_ORIGIN、PUBLIC_ORIGIN、FRONTEND_ORIGIN、WEB_ORIGIN
# APP_PUBLIC_ORIGIN="https://your-web.example.com"
# Docker/Sealos：若控制台未注入或值为空，镜像内 deploy/sealos-admin-login.env 会提供默认 API origin（见该文件注释）

WECHAT_APP_ID="your_wechat_mini_program_app_id"
WECHAT_APP_SECRET="your_wechat_mini_program_app_secret"

# 微信开放平台「网站应用」扫码登录（Web，与小程序 AppID 不同）
WECHAT_OPEN_APP_ID=""
WECHAT_OPEN_APP_SECRET=""
# API 域名完整 callback（无 /api 前缀时示例）：https://api.example.com/auth/wechat/web/callback
WECHAT_WEB_OAUTH_REDIRECT_URI=""
# 前端 SPA hash 回调（与 API 不同域）：https://web.example.com/#/auth/callback
AUTH_WEB_FRONTEND_CALLBACK=""

# 注册/登录策略（默认关闭短信注册与 OTP 登录）
AUTH_DISABLE_PHONE_REGISTER=true
AUTH_DISABLE_PHONE_OTP_LOGIN=true
AUTH_REGISTER_MAX_PER_IP_DAY=5
AUTH_REGISTER_MAX_PER_DEVICE_DAY=3
AUTH_CAPTCHA_SKIP_UNTIL=0
AUTH_CAPTCHA_TTL_SECONDS=300
# svg | geetest（未设且 GEETEST_ID 存在时默认 geetest）
AUTH_CAPTCHA_PROVIDER=svg
GEETEST_ID=""
GEETEST_KEY=""
# GEETEST_API_SERVER="http://gcaptcha4.geetest.com"

# Sign in with Apple（逗号分隔多个 client_id：Services ID / Bundle ID）
APPLE_CLIENT_ID=""

# Google OAuth（Web 扫码 + id_token 登录）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
# 默认同 AUTH_WEB_FRONTEND_CALLBACK
# AUTH_GOOGLE_FRONTEND_CALLBACK=""

# 强制已验证手机才能写 /me 与 POST /orders/*（默认 false，生产可 true）
AUTH_REQUIRE_VERIFIED_PHONE=false

# api-sports.io / API-Football v3（唯一运行时足球数据源：赛程、阵容、积分榜等）。密钥仅放环境变量，勿提交 git。
API_FOOTBALL_API_KEY="your_api_football_key"
# 可选，默认 https://v3.football.api-sports.io
# API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
# 日配额硬顶（Redis 计数 football:af:quota:YYYY-MM-DD），默认 7200
# API_FOOTBALL_DAILY_QUOTA=7200
# 生产关闭 C 端直连上游（403）；开发可 true 联调
# ENABLE_FOOTBALL_FEED_PUBLIC=false
# 历史 Football-Data 已废弃，仅迁移脚本需要时可开
# ENABLE_FOOTBALL_DATA=false
# FOOTBALL_DATA_API_KEY=
# FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# DeepSeek 外呼并发：单进程同时 HTTP 上限（排队，超时 503）；多副本总并发 ≈ 本值 × 副本数
DEEPSEEK_MAX_CONCURRENT=80
DEEPSEEK_ACQUIRE_WAIT_MS=180000
# HTTP 全局限流（@nestjs/throttler，每 IP、进程内内存；默认 60s 内 30000 次，支撑万级读 QPS 分散在多 IP 场景）
HTTP_THROTTLE_TTL_MS=60000
HTTP_THROTTLE_LIMIT=30000
# true 关闭 HTTP 限流（仅本地压测；禁止生产）
# HTTP_THROTTLE_DISABLED=true

QWEATHER_CREDENTIAL_ID="your_qweather_credential_id"
QWEATHER_API_KEY="your_qweather_api_key"
# 控制台「设置」专属 API Host（勿用 devapi.qweather.com，易 403 Invalid Host）
QWEATHER_BASE_URL="https://your-subdomain.re.qweatherapi.com"

WX_PAY_APP_ID="your_wechat_mini_program_app_id"
WX_PAY_MCH_ID="your_wechat_pay_mch_id"
WX_PAY_API_V3_KEY="your_wechat_pay_api_v3_key"
WX_PAY_SERIAL_NO="your_wechat_pay_certificate_serial_no"
WX_PAY_PRIVATE_KEY_PATH="./certs/apiclient_key.pem"
WX_PAY_NOTIFY_URL="https://your-api-domain.com/wxpay/notify"
# 可选：生产环境支付回调验签用「微信平台证书」公钥 PEM（整段一行可用 \n 转义换行）。
# 不配时：生产环境会尝试用商户身份 GET https://api.mch.weixin.qq.com/v3/certificates 拉取并解密平台证书后验签。
# WX_PAY_PLATFORM_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"

# V2 定价（分）：单场 ¥6.9、焦点 ¥9.9、海报 ¥4.9、Pro 月/季/年
REPORT_UNLOCK_PRICE_CENTS=690
FEATURED_REPORT_UNLOCK_PRICE_CENTS=990
SOCIAL_POSTER_PRICE_CENTS=490
MEMBERSHIP_PRO_MONTH_CENTS=4990
MEMBERSHIP_PRO_QUARTER_CENTS=12800
MEMBERSHIP_PRO_YEAR_CENTS=36500

ADMIN_BOOTSTRAP_OPENID="your_admin_openid"

# 管理后台 EJS（/admin-view/login）账号密码；与数据库中 ADMIN 用户无关，校验通过后签发该角色的 JWT
# 可与 deploy/sealos-admin-login.env 保持一致；npm start / Docker 会在未设置时自动加载该文件
ADMIN_VIEW_LOGIN_USERNAME=daojixian
ADMIN_VIEW_LOGIN_PASSWORD=daoji123456
# 浏览器访问管理后台的 URL 路径前缀（与地址栏一致，勿尾斜杠）。默认 /admin-view；若对外为 https://host/api/admin-view 则填 /api/admin-view
# ADMIN_VIEW_PATH_PREFIX=/api/admin-view

ENABLE_MOCK_LOGIN=true

# 手机验证码（占位短信，生产请接真实网关）；AUTH_OTP_PEPPER 建议单独随机串
# AUTH_OTP_PEPPER=
AUTH_OTP_TTL_SECONDS=300
# true 时 send-code 响应体会带 devCode（仅联调，禁止生产）
ENABLE_SMS_OTP_DEBUG=false
# false 且已配置 DEEPSEEK_API_KEY 时：AI 报告、战术沙盘、球员画像等走真实 DeepSeek（失败时战术/球员画像会回退占位逻辑）
ENABLE_MOCK_DEEPSEEK=true
# 为 true 且 ENABLE_CRON_SYNC=true 时：每 10 分钟跑公开来源分阶段任务（T-48h/T-8h/T-2h/完场后补抓）
ENABLE_PUBLIC_SOURCE_FETCH=true
ENABLE_CRON_SYNC=false
# 与 ENABLE_CRON_SYNC=true：每 5 分钟广域近窗刷新 af-f-* 比分/状态（默认关，省配额；生产建议 true）
# ENABLE_MATCH_FD_LIVE_POLL=true
# 与上项同时为 true：LIVE 场次约每 10 秒再拉 AF（极易爆配额，默认关）
# ENABLE_MATCH_LIVE_FAST_POLL=false

# 赛中 events/statistics（ENABLE_CRON_SYNC=true 时默认开）；tick 30s，实际间隔 AF_LIVE_FACTS_INTERVAL_SEC
# ENABLE_AF_LIVE_FACTS_CRON=true
# AF_LIVE_FACTS_INTERVAL_SEC=90
# AF_LIVE_FACTS_MAX_PER_TICK=4
# AF_LIVE_FACTS_DELAY_MS=400
# 赛中球员统计（/fixtures/players）
# ENABLE_AF_LIVE_PLAYERS_CRON=true
# AF_LIVE_PLAYERS_INTERVAL_SEC=120
# AF_LIVE_PLAYERS_MAX_PER_TICK=4
# LIVE 联赛积分榜物化（每 10min tick）
# ENABLE_LIVE_STANDINGS_TICK=true
# LIVE_STANDINGS_TICK_INTERVAL_SEC=600
# 文字直播 LLM 润色（默认关，需 DEEPSEEK_API_KEY）
# ENABLE_LIVE_COMMENTARY_LLM=false
# GET /matches/:id/live 短缓存 TTL（秒）
# CACHE_MATCH_LIVE_TTL_SEC=15

# 球员榜 / 积分榜读路径（生产建议 db + 管理端「物化积分榜」入库）
RANKINGS_DEFAULT_SOURCE=db
# ENABLE_RANKINGS_AF_FALLBACK=false

# React 运维后台（构建后由 Nest 托管于 /admin）
# npm run build:admin
# 种子管理员：ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD（见 prisma/seed.ts）
# ADMIN_BOOTSTRAP_EMAIL=admin@local.dev
# ADMIN_BOOTSTRAP_PASSWORD=admin123456

# 危险：清空库并 migrate + seed（需 CONFIRM_DB_NUKE=yes）
# npm run db:nuke-rebuild
# CACHE_RANKINGS_TOPSCORERS_TTL_SEC=21600
# CACHE_LEAGUES_STANDINGS_TTL_SEC=1800
# CACHE_MATCH_INJURIES_TTL_SEC=600

# 赛后 AI 复盘 + 文字直播叙事（需 ENABLE_CRON_SYNC=true，默认开）
# ENABLE_POST_MATCH_REPORT_CRON=false
# POST_MATCH_REPORT_MAX_PER_TICK=6
# POST_MATCH_REPORT_LOOKBACK_HOURS=24
# ENABLE_LIVE_NARRATIVE_CRON=false

# 三页合同短缓存 TTL（秒）
# CACHE_MATCH_PHASE_PRE_TTL_SEC=30
# CACHE_MATCH_PHASE_POST_TTL_SEC=60

# 自动情报 / 预测（需 ENABLE_CRON_SYNC=true）：off | prediction | full。prediction=仅批量 generate-prediction；full=Phase C 全管线（定时默认不跑 AI 报告，见下一项）
# AUTO_INTEL_CRON_MODE=off
# AUTO_INTEL_LOOKAHEAD_HOURS=72
# AUTO_INTEL_LOOKBACK_HOURS=12
# AUTO_INTEL_MAX_PER_TICK=8
# AUTO_INTEL_DELAY_MS=2500
# AUTO_INTEL_FULL_INCLUDE_AI_REPORT=false

# 预测：af | model | auto（af-f-* 先 AF /predictions，失败回退 OLS/Elo v3）
# PREDICTION_PROVIDER=auto
# ENABLE_PREDICTION_DEEPSEEK_ENRICH=false
# 每 6h 近窗缺预测场次 AF 同步（需 ENABLE_CRON_SYNC=true）
# ENABLE_AF_PREDICTIONS_NEAR_WINDOW_CRON=false
# AF_PREDICTIONS_NEAR_WINDOW_LOOKAHEAD_HOURS=48
# AF_PREDICTIONS_NEAR_WINDOW_MAX_PER_TICK=12
# AF_PREDICTIONS_NEAR_WINDOW_DELAY_MS=2000

# 赛前 AI 报告定时草稿（需 ENABLE_CRON_SYNC=true）：无 DRAFT/PUBLISHED 时批量 generate；与 AUTO_INTEL 独立，建议先开 prediction 再开本项
# AUTO_AI_REPORT_CRON=false
# AUTO_AI_REPORT_LOOKAHEAD_HOURS=96
# AUTO_AI_REPORT_LOOKBACK_HOURS=12
# 距开球至少 N 分钟的 SCHEDULED 才自动生成（临场仍可在后台手点）；LIVE 无此限制
# AUTO_AI_REPORT_MIN_LEAD_MINUTES=120
# AUTO_AI_REPORT_MAX_PER_TICK=3
# AUTO_AI_REPORT_DELAY_MS=8000
# 默认 true：仅已有 MatchPrediction 的场次才自动生成；设为 false 可仅靠档案层生成
# AUTO_AI_REPORT_REQUIRE_PREDICTION=false
# true=跳过 FD/公开来源再拉取，仅用库内档案（省配额）
# AUTO_AI_REPORT_SKIP_EXTERNAL=false
# 赛前报告 JSON 调用温度（略低更稳）
# DEEPSEEK_REPORT_TEMPERATURE=0.35
ENABLE_WXPAY_DEV_PLACEHOLDER=true

# 社交分享海报（GPT-Image2 兼容接口，如 aigc.x-see.cn）。密钥仅放环境变量，勿提交 git；聊天/工单泄露后请立即在控制台作废并换新。
GPT_IMAGE2_BASE_URL=https://aigc.x-see.cn
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_PATH=/v1/images/generations
GPT_IMAGE2_MODEL=gpt-image-2
# 未配置 Key 时 true 可走通流程（占位图）
ENABLE_POSTER_IMAGE_MOCK=true
# 本地 true：海报生成不扣免费次数/会员/订单（勿上生产）
ENABLE_POSTER_DEV_BYPASS=false
# 海报单次金额见上文 V2「SOCIAL_POSTER_PRICE_CENTS」

LEAGUE_AVG_GOALS=2.70
HOME_ADVANTAGE_XG=1.08
AWAY_ADVANTAGE_XG=0.94
HOME_ELO_ADVANTAGE=65

# ---------- Redis 读缓存（可选；不配 REDIS_URL / REDIS_HOST 则仅跳过 Redis，应用照常启动）----------
# REDIS_URL=redis://:password@redis:6379/0
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_KEY_PREFIX=football:

# 各接口 Redis TTL（秒）
# CACHE_MATCHES_LIST_TTL_SEC=20
# CACHE_MATCH_INTEL_ANON_TTL_SEC=15
# CACHE_MATCH_DETAIL_ANON_TTL_SEC=15
# CACHE_MATCH_INTEL_USER_TTL_SEC=5
# CACHE_MATCH_DETAIL_USER_TTL_SEC=5
# CACHE_TOURNAMENTS_TTL_SEC=30

# ---------- CDN / 浏览器缓存头（匿名 GET 写 public+s-maxage；带 Bearer 的情报/详情写 private,no-store）----------
# CDN_CACHE_HEADERS_ENABLED=true
# HTTP_CACHE_S_MAXAGE_SEC=30
# HTTP_CACHE_STALE_WHILE_REVALIDATE_SEC=120

# ---------- 生产环境安全（NODE_ENV=production 时由 env.validation 与启动逻辑强制）----------
# JWT_SECRET 须 ≥24 字符且非占位串；CORS_ORIGIN 须为逗号分隔白名单，禁止 *。
# ENABLE_MOCK_LOGIN / ENABLE_SMS_OTP_DEBUG / WXPAY_NOTIFY_SKIP_VERIFY / HTTP_THROTTLE_DISABLED 在生产必须为 false 或未设置。
# production 默认不暴露 /docs；需 Swagger 时显式：ENABLE_SWAGGER_DOCS=true
# ENABLE_SWAGGER_DOCS=true
# 仅非 production：本地假微信支付回调时 WXPAY_NOTIFY_SKIP_VERIFY=true（跳过 v3 验签；禁止与 production 同用）
# WXPAY_NOTIFY_SKIP_VERIFY=true
