{
  "name": "football-ai-report-api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "start": "node -r ./scripts/load-sealos-admin-env.js dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node -r ./scripts/load-sealos-admin-env.js dist/main.js",
    "db:ping": "node scripts/db-ping.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:nuke-rebuild": "node -r ts-node/register/transpile-only scripts/db-nuke-rebuild.ts",
    "build:admin": "cd admin-web && npm ci && npm run build",
    "ci:contract-routes": "node -r ts-node/register/transpile-only scripts/ci-contract-public-routes.ts",
    "audit:schedule": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/audit-schedule-scores.ts",
    "stats:match-report": "ts-node scripts/db-match-stats-report.ts",
    "powers:backfill": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/backfill-match-powers.ts",
    "prediction:backtest": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/prediction-backtest.ts",
    "live-sync:latency-report": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/live-sync-latency-report.ts",
    "report:fact-check-sample": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/report-fact-check-sample.ts",
    "report:post-match-batch": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/post-match-report-batch.ts",
    "match-phase:smoke": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/match-phase-smoke.ts",
    "ops:af-cost-report": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/api-football-cost-report.ts",
    "test": "jest --config jest.config.cjs",
    "test:ci": "jest --config jest.config.cjs --ci --forceExit",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand --forceExit",
    "ci:health-e2e": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/ci-health-e2e.ts",
    "ci:l1": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/ci-run-l1-suite.ts",
    "ci:report": "node scripts/ci-report-aggregator.mjs",
    "test:concurrency": "node scripts/concurrency-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "mysql2": "^3.11.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.3.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
