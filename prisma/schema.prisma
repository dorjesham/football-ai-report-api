  message    String?  @db.Text
  createdAt  DateTime @default(now())
}

/** AF API 日配额快照（运维图表） */
model AfQuotaDailySnapshot {
  id        String   @id @default(cuid())
  date      String   @unique
  used      Int      @default(0)
  limit     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** 用户生成素材（海报/文案等） */
model UserGeneratedAsset {
  id           String   @id @default(cuid())
  userId       String
  assetType    String
  matchId      String?
  title        String?
  url          String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([matchId, createdAt])
}

/** 全站实体中文翻译（权威记录；实体 nameCn 为 approved 回写缓存） */
model EntityTranslation {
  id             String    @id @default(cuid())
  entityType     String
  entityId       String?
  externalSource String?  @db.VarChar(32)
  externalId     String?  @db.VarChar(64)
  locale         String    @default("zh-CN")
  field          String    @default("name")
  sourceText     String?
  translatedText String
  shortText      String?
  aliasJson      Json?
  metadataJson   Json?
  source         String
  status         String
  confidence     Float?
  locked         Boolean   @default(false)
  updatedBy      String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([entityType, externalId, locale, field], map: "et_ext_locale_field_uq")
  @@index([entityType, entityId])
  @@index([status, source])
}

/** Admin 运维后台操作审计 */
model AdminAuditLog {
  id           String   @id @default(cuid())
  operatorId   String?
  operatorName String?
  action       String
  targetType   String?
  targetId     String?
  beforeJson   Json?
  afterJson    Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([action, createdAt])
  @@index([operatorId, createdAt])
}
