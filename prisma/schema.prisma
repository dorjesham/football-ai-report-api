generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/** 运维后台控制台角色（仅 User.role = ADMIN） */
enum AdminConsoleRole {
  SUPER_ADMIN
  OPS_ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
  READONLY
  DEVELOPER
}

enum BrowseHistoryType {
  ANALYSIS
  POSTER
  VIEW
}

enum UserNotificationType {
  ORDER_PAID
  POSTER_READY
  POSTER_CREDIT
  MEMBERSHIP
  SYSTEM
}

enum DataQuality {
  PUBLIC_DATA
  MANUAL_INPUT
  MODEL_ESTIMATED
  AI_GENERATED
  UNKNOWN
}

enum DataSourceType {
  /**
   * api-sports.io / API-Football（v3），主数据源（赛程/阵容等）
   */
  API_FOOTBALL
  FOOTBALL_DATA
  DEEPSEEK
  QWEATHER
  WIKIPEDIA
  FIFA
  UEFA
  FPL
  KAGGLE
  ESPN
  WORLDFOOTBALL
  ELEVEN_V_ELEVEN
  TRANSFERMARKT
  /**
   * StatsBomb Open Data（GitHub 开放数据集，须遵守其许可）
   */
  STATSBOMB
  MANUAL
  MODEL
  UNKNOWN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  UNKNOWN
}

enum ReportStatus {
  NONE
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum AiReportType {
  PRE_MATCH
  POST_MATCH
  LIVE_NARRATIVE
}

/**
 * 单场情报生成管线执行记录（Phase C）
 */
enum PipelineRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum OrderStatus {
  CREATED
  PAYING
  PAID
  CLOSED
  FAILED
  REFUNDED
}

enum OrderProduct {
  REPORT_UNLOCK
  /**
   * 焦点战等：单价高于普通单场（见 isFeatured + featuredReportUnlockPriceCents）
   */
  FEATURED_REPORT_UNLOCK
  SOCIAL_POSTER
  MEMBERSHIP_PRO_MONTH
  MEMBERSHIP_PRO_QUARTER
  MEMBERSHIP_PRO_YEAR
}

enum PaymentProvider {
  WECHAT
}

enum TournamentType {
  DOMESTIC_LEAGUE
  DOMESTIC_CUP
  CONTINENTAL_CLUB
  CONTINENTAL_NATIONAL
  GLOBAL_NATIONAL
  GLOBAL_CLUB
  FRIENDLY
  OTHER
}

enum CompetitionLevel {
  TIER_1
  TIER_2
  TIER_3
  CUP
  INTERNATIONAL
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  MEDIUM_HIGH
  HIGH
  UNKNOWN
}

model User {
  id                     String    @id @default(cuid())
  /**
   * 微信小程序 openid（支付 JSAPI 依赖此字段）
   */
  openid                 String?   @unique
  /**
   * 微信开放平台网站应用扫码 openid（与小程序 openid 不同）
   */
  wechatWebOpenid        String?   @unique
  unionid                String?
  /**
   * 邮箱注册/登录（小写存储）
   */
  email                  String?   @unique
  /**
   * 用户名注册/登录（3–32 位字母数字下划线）
   */
  username               String?   @unique
  /**
   * Sign in with Apple `sub`
   */
  appleSub               String?   @unique
  /**
   * Google OAuth `sub`
   */
  googleSub              String?   @unique
  /**
   * 中国大陆手机建议存 11 位数字；E.164 亦可，须与发送验证码时规范化一致
   */
  phone                  String?   @unique
  phoneVerifiedAt        DateTime?
  /**
   * bcrypt 哈希；手机注册后可 PATCH 设置
   */
  passwordHash           String?
  nickname               String?
  avatarUrl              String?
  role                   UserRole  @default(USER)
  adminConsoleRole       AdminConsoleRole?
  /**
   * 社交分享海报：每位用户终身一次免费（消耗后 true）
   */
  socialPosterFreeUsed   Boolean   @default(false)
  /**
   * UTC 自然月 YYYYMM；与 posterFreeUsedInMonth 配合实现「每月 1 张免费海报」
   */
  posterFreeUtcYearMonth Int       @default(0)
  /**
   * 当前 posterFreeUtcYearMonth 内已用免费张数（0/1）
   */
  posterFreeUsedInMonth  Int       @default(0)
  /**
   * Pro 会员有效期：无限单场情报 + 无限海报（旧字段 posterMemberDay* 保留兼容，新逻辑不再递增）
   */
  membershipUntil        DateTime?
  /**
   * @deprecated 历史「会员每日 5 张海报」计数；V2 Pro 为无限，新代码不再写入
   */
  posterMemberDayKey     Int?
  /**
   * @deprecated 见 posterMemberDayKey
   */
  posterMemberDayCount   Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  orders          Order[]
  unlocks         PaymentUnlock[]
  wcTeamFollows   UserTeamFollow[]
  favoriteMatches UserMatchFavorite[]
  matchReminders  UserMatchReminder[]
  preferences     UserPreferences?
  feedbacks       UserFeedback[]
  browseHistories UserBrowseHistory[]
  notifications   UserNotification[]
  generatedAssets UserGeneratedAsset[]
}

/**
 * 手机验证码（短期有效，一次性消费）
 */
model AuthPhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/**
 * 用户关注的 2026 世界杯国家队（externalId 前缀 af-t-）
 */
model UserTeamFollow {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
}

model UserMatchFavorite {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
}

model UserMatchReminder {
  id                  String   @id @default(cuid())
  userId              String
  matchId             String
  /**
   * 开球前多少分钟提醒（正数）
   */
  notifyOffsetMinutes Int      @default(60)
  /**
   * app | sms（仅占位；推送通道由后续接入）
   */
  channel             String   @default("app")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
}

model UserPreferences {
  userId    String   @id
  /**
   * 前端约定：matchRemind、scoreAlert 等布尔或字符串
   */
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFeedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String   @db.Text
  contact   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model UserBrowseHistory {
  id         String            @id @default(cuid())
  userId     String
  type       BrowseHistoryType
  matchId    String?
  title      String
  sub        String?
  visitedAt  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([userId, matchId, type])
  @@index([userId, visitedAt])
}

model UserNotification {
  id        String                @id @default(cuid())
  userId    String
  type      UserNotificationType  @default(SYSTEM)
  title     String
  desc      String                @db.Text
  read      Boolean               @default(false)
  icon      String?
  color     String?
  link      String?
  orderNo   String?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Tournament {
  id          String           @id @default(cuid())
  code        String           @unique
  nameCn      String
  nameEn      String
  type        TournamentType
  level       CompetitionLevel @default(TIER_1)
  region      String?
  country     String?
  organizer   String?
  isGlobal    Boolean          @default(false)
  isActive    Boolean          @default(true)
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  competitions     Competition[]
  matches          Match[]
  providerMappings DataProviderMapping[]
}

model Season {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  year      Int?
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  competitions Competition[]
  matches      Match[]
}

model Competition {
  id                String           @id @default(cuid())
  tournamentId      String?
  seasonId          String?
  externalId        String?          @unique
  code              String?
  nameCn            String
  nameEn            String
  shortNameCn       String?
  country           String?
  seasonName        String?
  currentMatchday   Int?
  level             CompetitionLevel @default(TIER_1)
  dataSource        DataSourceType   @default(UNKNOWN)
  /**
   * API-Football（api-sports）联赛 id，如英超 39；与 code 并行便于同步
   */
  apiSportsLeagueId Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tournament       Tournament?           @relation(fields: [tournamentId], references: [id])
  season           Season?               @relation(fields: [seasonId], references: [id])
  matches          Match[]
  providerMappings DataProviderMapping[]
  standings        CompetitionStanding[]
  playerMetrics    PlayerSeasonMetric[]

  @@index([tournamentId, seasonId])
  @@index([apiSportsLeagueId])
}

/**
 * 物化积分榜（C 端 GET /leagues/standings 只读此表）
 */
model CompetitionStanding {
  id            String   @id @default(cuid())
  competitionId String
  seasonYear    Int
  groupName     String   @default("")
  rank          Int
  teamId        String
  points        Int?
  played        Int?
  won           Int?
  draw          Int?
  lost          Int?
  goalsFor      Int?
  goalsAgainst  Int?
  goalDiff      Int?
  form          String?
  extra         Json?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competitionId, seasonYear, teamId, groupName], map: "cs_season_team_grp_uq")
  @@index([competitionId, seasonYear], map: "cs_comp_season_idx")
}

/**
 * 物化球员榜指标（C 端 GET /rankings/players?source=db）
 */
model PlayerSeasonMetric {
  id            String   @id @default(cuid())
  competitionId String
  seasonYear    Int
  playerId      String
  teamId        String?
  metric        String
  value         Float
  rank          Int?
  goals         Int?
  assists       Int?
  extra         Json?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([competitionId, seasonYear, playerId, metric], map: "psm_season_player_metric_uq")
  @@index([competitionId, seasonYear, metric], map: "psm_comp_season_metric_idx")
}

model DataProviderMapping {
  id                      String         @id @default(cuid())
  provider                DataSourceType
  tournamentId            String?
  competitionId           String?
  providerCompetitionCode String?
  providerCompetitionId   String?
  providerSeasonCode      String?
  extra                   Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  tournament  Tournament?  @relation(fields: [tournamentId], references: [id])
  competition Competition? @relation(fields: [competitionId], references: [id])

  @@index([provider, providerCompetitionCode])
}

model AfTeamNameOverride {
  id                String   @id @default(cuid())
  apiFootballTeamId Int      @unique
  nameCn            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Team {
  id              String         @id @default(cuid())
  externalId      String?        @unique
  /** API-Football numeric team id (denormalized from af-t-{id}) */
  apiFootballTeamId Int?
  nameCn          String
  nameEn          String
  shortNameCn     String?
  shortName       String?
  logoUrl         String?
  country         String?
  founded         Int?
  venue           String?
  website         String?
  dataSource      DataSourceType @default(UNKNOWN)
  /**
   * 2026 世界杯小组赛档位 A–L（仅世界杯种子队使用）
   */
  wcGroup         String?
  /**
   * 2026 世界杯扩展档案：AF team card / statistics + 可选 manual 白名单字段
   */
  wc2026Profile   Json?
  /**
   * FD 教练档案：`/teams/{id}` 的 coach、可选 `/persons`、`/persons/.../matches`、
   * 以及近若干场 `/matches/{id}` 摘录的阵型/教练席；战术理念长文本 FD 不提供时见 JSON 内 `tacticalSemantics`。
   */
  coachProfile    Json?
  /**
   * OLS 文档一：俱乐部/国家队基础战力 TPR（约 35–99，无快照时可能为 null）
   */
  powerRating     Float?
  /**
   * 子分项、模型版本等 JSON
   */
  powerRatingMeta Json?
  powerRatingAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apiFootballTeamId])

  players               Player[]
  homeMatches           Match[]               @relation("MatchHomeTeam")
  awayMatches           Match[]               @relation("MatchAwayTeam")
  teamSnapshots         TeamMatchSnapshot[]
  playerSnapshotsOnTeam PlayerMatchSnapshot[] @relation("PlayerSnapshotTeam")
  playerIntelAsTeam     PlayerIntelligence[]  @relation("IntelTeam")
  userFollows           UserTeamFollow[]
  competitionStandings  CompetitionStanding[]
  playerSeasonMetrics   PlayerSeasonMetric[]
  afTransferRaws        AfTransferRaw[]
  afTrophyRaw           AfTrophyRaw?

  @@index([wcGroup])
}

model Player {
  id                 String         @id @default(cuid())
  teamId             String
  externalId         String?
  nameCn             String
  nameEn             String
  shortNameCn        String?
  /**
   * 头像 URL：抓取 JSON 中的图片字段或常量表手工映射
   */
  avatarUrl          String?
  position           String?
  nationality        String?
  shirtNumber        Int?
  fantasyPrice       Float?
  fantasySource      String?
  status             String?
  dataSource         DataSourceType @default(UNKNOWN)
  /**
   * 扩展档案：身体/身价/多位置/多来源 id 等（Zod 校验后写入）
   */
  profile            Json?
  /**
   * FBref CSV 最近一次成功写入（与 profile.fbref 对齐）
   */
  fbrefStatsSyncedAt DateTime?
  /**
   * 与 profile.fbref.seasons 下的季次 key 一致，便于筛选
   */
  fbrefSeasonTag     String?        @db.VarChar(40)
  /**
   * FBref「Min」列解析后的总分钟（便于排序；明细见 profile.fbref）
   */
  fbrefMinutes       Int?
  /**
   * OLS 文档二：球员战斗力 PPR
   */
  powerRating        Float?
  powerRatingMeta    Json?
  powerRatingAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team          Team                  @relation(fields: [teamId], references: [id])
  snapshots     PlayerMatchSnapshot[]
  intelligences PlayerIntelligence[]
  seasonMetrics PlayerSeasonMetric[]
  matchStats    MatchPlayerMatchStat[]
  afTrophyRaw   AfTrophyRaw?
  afSidelinedRaw AfSidelinedRaw?

  @@index([teamId])
  @@index([fbrefSeasonTag])
  @@index([fbrefStatsSyncedAt])
}

model Match {
  id                       String         @id @default(cuid())
  externalId               String?        @unique
  competitionId            String
  tournamentId             String?
  seasonId                 String?
  round                    String?
  /**
   * 联赛轮次序号（与 football-data matchday 等对齐时可填）
   */
  matchday                 Int?
  stage                    String?
  groupName                String?
  /**
   * 两回合制场次序号
   */
  leg                      Int?
  homeTeamId               String
  awayTeamId               String
  stadium                  String?
  city                     String?
  cityCn                   String?
  country                  String?
  kickoffTime              DateTime
  status                   MatchStatus    @default(SCHEDULED)
  homeScore                Int?
  awayScore                Int?
  isFeatured               Boolean        @default(false)
  reportStatus             ReportStatus   @default(NONE)
  dataSource               DataSourceType @default(UNKNOWN)
  /**
   * StatsBomb Open Data `match_id`（与 GitHub `data/events/{id}.json` 一致）
   */
  statsbombMatchId         Int?           @unique
  /**
   * 定时公开来源：开球前约 48h 首轮抓取完成时间
   */
  publicSourcesPhase48At   DateTime?
  /**
   * 开球前约 8h
   */
  publicSourcesPhase8At    DateTime?
  /**
   * 开球前约 2h
   */
  publicSourcesPhase2At    DateTime?
  /**
   * 完场后补抓（见 Cron 窗口逻辑）
   */
  publicSourcesPhasePostAt DateTime?
  /**
   * API-Football 赛前快照：开球前约 24h
   */
  afPreMatchSnapshot24At   DateTime?
  /**
   * 开球前约 1h
   */
  afPreMatchSnapshot1At    DateTime?
  /**
   * 赔率快照 T-24h
   */
  afOddsSnapshot24At       DateTime?
  /**
   * 赔率快照 T-1h
   */
  afOddsSnapshot1At        DateTime?
  /**
   * 当前对外展示的预测版本（C 端 intel / detail 读此指针）
   */
  activePredictionId       String?        @unique
  /**
   * 情报内容指纹（bundle/snapshot/prediction/weather 等稳定 hash）
   */
  intelContentHash         String?
  intelContentHashAt       DateTime?
  venueName                String?
  venueNameCn              String?
  venueApiFootballId       Int?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  competition        Competition           @relation(fields: [competitionId], references: [id])
  tournament         Tournament?           @relation(fields: [tournamentId], references: [id])
  season             Season?               @relation(fields: [seasonId], references: [id])
  homeTeam           Team                  @relation("MatchHomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team                  @relation("MatchAwayTeam", fields: [awayTeamId], references: [id])
  teamSnapshots      TeamMatchSnapshot[]
  playerSnapshots    PlayerMatchSnapshot[]
  refereeSnapshot    RefereeSnapshot?
  weatherSnapshot    WeatherSnapshot?
  activePrediction   MatchPrediction?      @relation("ActivePrediction", fields: [activePredictionId], references: [id], onDelete: SetNull)
  predictions        MatchPrediction[]     @relation("MatchPredictions")
  predictionGradings MatchPredictionGrading[]
  playerIntelligence PlayerIntelligence[]
  tacticalScenarios  TacticalScenario[]
  tacticalSandbox    MatchTacticalSandbox?
  fantasyAdvice      FantasyAdvice?
  headToHead         HeadToHeadInsight?
  socialGuide        SocialGuide?
  aiReports          AiReport[]
  orders             Order[]
  unlocks            PaymentUnlock[]
  sourceRecords      SourceRecord[]
  pipelineRuns       MatchPipelineRun[]
  matchFacts         MatchFacts?
  afRawBundle        MatchAfRawBundle?
  oddsSnapshots      MatchOddsSnapshot[]
  oddsLiveSnapshots  MatchOddsLiveSnapshot[]
  favoriteUsers      UserMatchFavorite[]
  reminderUsers      UserMatchReminder[]
  browseHistories    UserBrowseHistory[]
  playerMatchStats   MatchPlayerMatchStat[]

  @@index([kickoffTime])
  @@index([isFeatured])
  @@index([tournamentId])
  @@index([competitionId])
  @@index([seasonId])
}

/**
 * 单场「事实包」：完赛后的扩展比分、统计、阵容、事件等多嵌套字段。
 * 优先用结构化 JSON + Zod 校验落库；与 Match 核心字段（比分/状态）同步互补。
 */
model MatchFacts {
  matchId String @id
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  minuteRegulation Int?
  attendance       Int?
  htHome           Int?
  htAway           Int?
  /**
   * 全场（常规时间终场，与 Match.homeScore 一致时可冗余）
   */
  ftHome           Int?
  ftAway           Int?
  etHome           Int?
  etAway           Int?
  penHome          Int?
  penAway          Int?

  /**
   * 控球、射门、xG 等聚合统计
   */
  teamStats     Json?
  /**
   * 首发/替补/阵型
   */
  lineups       Json?
  /**
   * 进球/换人等事件列表
   */
  events        Json?
  /**
   * 裁判组、VAR
   */
  officials     Json?
  venueDetail   Json?
  weatherDetail Json?

  /**
   * 上游原始快照（便于追溯与二次解析）
   */
  rawFdMatch      Json?
  rawOpenfootball Json?
  /**
   * StatsBomb Open Data 原始 lineups/events 等（大 JSON；许可见 https://github.com/statsbomb/open-data）
   */
  rawStatsbomb    Json?
  /**
   * API-Football（api-sports）GET /fixtures?id= 单项快照（写入前可 shrink，见 MatchAfFactsSyncService）
   */
  rawAfFixture Json?
  /**
   * 最后一次从 API-Football 拉取单场事实包（lineups/events/statistics/fixture）的时间
   */
  afLastSyncedAt DateTime?
  /**
   * 赛中增量：AF events/statistics 上次拉取时刻
   */
  afLiveLastSyncedAt DateTime?
  /**
   * 赛中增量：Football-Data 单场详情上次拉取时刻
   */
  fdLiveLastSyncedAt DateTime?
  /**
   * 赛中元数据：比分快照、seq、合成事件状态等
   */
  liveMetaJson Json?
  /**
   * 赛中技术统计时间轴（live-stats-timeline-v1）
   */
  liveStatsTimelineJson Json?
  /**
   * 可选 LLM 润色文字直播（ENABLE_LIVE_COMMENTARY_LLM）
   */
  liveCommentaryEnrichedJson Json?

  /**
