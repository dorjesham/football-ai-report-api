<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <%- include('_admin-theme') %>
</head>
<body>
  <% 
    var pageTitle = typeof locals.title !== 'undefined' && locals.title ? locals.title : '运维后台登录';
    var pwdLogin = locals.passwordLoginEnabled === true;
    var errMsg = typeof locals.error !== 'undefined' && locals.error ? locals.error : '';
    var avBase = (typeof locals.adminViewPathPrefix !== 'undefined' && locals.adminViewPathPrefix) ? String(locals.adminViewPathPrefix).replace(/\/$/, '') : '/admin-view';
  %>
  <div class="admin-login-wrap">
    <div class="admin-login-card">
      <h1><%= pageTitle %></h1>
      <p class="sub">赛程、情报与订单日常维护入口</p>
      <% if (errMsg) { %>
        <p class="err"><%= errMsg %></p>
      <% } %>

      <% if (pwdLogin) { %>
        <p class="admin-muted" style="font-size:0.85rem;margin:0 0 0.5rem;">使用部署平台里配置的账号与密码（与 README / 环境变量说明一致）。</p>
        <form method="post" action="<%= avBase %>/password-login" autocomplete="current-password">
          <label for="username">账号</label>
          <input id="username" name="username" type="text" required autocomplete="username" />
          <label for="password">密码</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" />
          <button type="submit">登录</button>
        </form>
      <% } else { %>
        <p class="admin-muted" style="font-size:0.85rem;">未配置账号密码时，请使用下方 JWT 方式（开发环境可参阅项目 README 中的 mock 登录说明）。</p>
      <% } %>

      <details>
        <summary>使用 JWT 登录</summary>
        <p class="admin-muted" style="font-size:0.8rem;margin:0.5rem 0;">在开发环境取得管理员 accessToken 后粘贴到下方。</p>
        <form method="post" action="<%= avBase %>/session">
          <label for="token">Token</label>
          <textarea id="token" name="token" placeholder="eyJhbGciOi..." <%= pwdLogin ? '' : 'required' %>></textarea>
          <button type="submit">写入 Cookie 并进入</button>
        </form>
      </details>
    </div>
  </div>
</body>
</html>
