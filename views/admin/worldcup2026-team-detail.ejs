<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <%- include('_admin-theme') %>
</head>
<body class="admin-body">
  <% var avBase = (typeof locals.adminViewPathPrefix !== 'undefined' && locals.adminViewPathPrefix) ? locals.adminViewPathPrefix : '/admin-view'; %>
  <div class="admin-layout">
    <%- include('_nav') %>
    <main class="admin-main" style="max-width:920px;">
      <h1 class="admin-page-title"><%= title %></h1>
      <p class="admin-page-sub"><code><%= team.externalId %></code> · 组 <%= team.wcGroup || '—' %></p>
      <p><a class="admin-back" href="<%= avBase %>/worldcup2026-teams">← 48 强列表</a></p>

      <% if (locals.flashOk) { %>
        <p class="admin-flash-ok">已保存。</p>
      <% } %>

      <section class="admin-card">
        <p class="admin-muted" style="margin:0 0 1rem;">
          保存后写入数据库 <code>Team.wc2026Profile</code> / <code>founded</code>；再次执行 seed 时，<strong>未在</strong> <code>wc2026_team_detail_overrides.json</code> 中出现的键会<strong>保留</strong>库内值。
        </p>
        <form method="post" action="<%= avBase %>/worldcup2026-team-detail/<%= team.id %>">
          <div style="margin-bottom:0.75rem;">
            <label>成立年份 founded</label>
            <input type="number" name="founded" value="<%= team.founded != null ? team.founded : '' %>" placeholder="留空则不修改" style="width:120px;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>一句话 marketingSummary</label>
            <input type="text" name="marketingSummary" value="<%= profile.marketingSummary != null ? String(profile.marketingSummary) : '' %>" style="width:100%;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>长文案 aiInsight</label>
            <textarea name="aiInsight" rows="6" style="width:100%;"><%= profile.aiInsight != null ? String(profile.aiInsight) : '' %></textarea>
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>版本 contentVersion</label>
            <input type="text" name="contentVersion" value="<%= profile.contentVersion != null ? String(profile.contentVersion) : '' %>" style="width:100%;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>主教练 headCoachName</label>
            <input type="text" name="headCoachName" value="<%= profile.headCoachName != null ? String(profile.headCoachName) : '' %>" style="width:100%;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>晋级说明 qualificationLabel</label>
            <textarea name="qualificationLabel" rows="2" style="width:100%;"><%= profile.qualificationLabel != null ? String(profile.qualificationLabel) : '' %></textarea>
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>赛区展示名 regionDisplayName</label>
            <input type="text" name="regionDisplayName" value="<%= profile.regionDisplayName != null ? String(profile.regionDisplayName) : '' %>" style="width:100%;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>战术关键词 tacticalTags（英文逗号分隔）</label>
            <input type="text" name="tacticalTags" value="<%= tacticalTagsStr %>" style="width:100%;" />
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>核心球员 keyPlayersJson（JSON 数组）</label>
            <textarea name="keyPlayersJson" rows="8" style="width:100%;font-family:monospace;font-size:0.8rem;"><%= keyPlayersJson %></textarea>
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>tacticalPitchJson（JSON 对象）</label>
            <textarea name="tacticalPitchJson" rows="6" style="width:100%;font-family:monospace;font-size:0.8rem;"><%= tacticalPitchJson %></textarea>
          </div>
          <div style="margin-bottom:0.75rem;">
            <label>aiPowerScoreJson（JSON 对象）</label>
            <textarea name="aiPowerScoreJson" rows="5" style="width:100%;font-family:monospace;font-size:0.8rem;"><%= aiPowerScoreJson %></textarea>
          </div>
          <button type="submit" class="admin-btn">保存</button>
        </form>
      </section>
    </main>
  </div>
</body>
</html>
