<% 
  var t = typeof team !== 'undefined' && team ? team : null;
  var isLg = typeof size !== 'undefined' && size === 'lg';
  var initial = t ? String((t.nameCn || t.nameEn || '?')).trim().charAt(0) : '?';
%>
<% if (t) { %>
<div class="admin-team-block<%= isLg ? ' admin-team-block--lg' : '' %>">
  <% if (t.logoUrl) { %>
    <img class="admin-team-crest" src="<%= t.logoUrl %>" alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" />
  <% } else { %>
    <span class="admin-team-crest-ph" aria-hidden="true"><%= initial %></span>
  <% } %>
  <div class="admin-team-lines">
    <div class="admin-team-cn"><%= t.nameCn %></div>
    <% if (t.nameEn && t.nameEn !== t.nameCn) { %><div class="admin-team-en"><%= t.nameEn %></div><% } %>
  </div>
</div>
<% } %>
