<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <%- include('_admin-theme') %>
</head>
<body class="admin-body">
  <% var avBase = (typeof locals.adminViewPathPrefix !== 'undefined' && locals.adminViewPathPrefix) ? locals.adminViewPathPrefix : '/admin-view'; %>
  <div class="admin-layout">
    <%- include('_nav') %>
    <main class="admin-main" style="max-width:1200px;">
      <h1 class="admin-page-title"><%= title %></h1>
      <p class="admin-page-sub">种子数据（externalId 前缀 <code>wc26-</code>），与公开 API 同源</p>
      <p><a class="admin-back" href="<%= avBase %>/competitions">← 杯赛列表</a></p>

      <section class="admin-card">
        <p style="margin:0 0 0.5rem;"><strong>实例 ID</strong> <code style="font-size:0.8rem;"><%= comp.id %></code></p>
        <p class="admin-muted" style="margin:0 0 0.75rem;">
          code <strong><%= comp.code || '—' %></strong>
          · 赛季 <strong><%= comp.season ? comp.season.code : '—' %></strong>
          · 赛事 <strong><%= comp.tournament ? comp.tournament.code : '—' %></strong>
        </p>
        <p style="margin:0 0 0.5rem;font-size:0.875rem;">
          公开 JSON（需带用户 Token）：<br />
          <a href="<%= locals.restJsonPath %>"><code><%= locals.restJsonPath %></code></a>
          ·
          <a href="<%= locals.slimJsonPath %>"><code>?slim=1</code></a>（省略近期场次明细）
        </p>
        <p class="admin-muted" style="margin:0;font-size:0.8rem;">本页为 slim 视图：近期国际赛仅展示 summary，不含逐场 matches。</p>
      </section>

      <section class="admin-card" style="margin-top:1rem;">
        <p style="margin:0 0 0.75rem;">共 <strong><%= (rows && rows.length) || 0 %></strong> 支球队</p>
        <div style="overflow-x:auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>组</th>
                <th>简称</th>
                <th>中文名</th>
                <th>English</th>
                <th>externalId</th>
                <th>FIFA 名次</th>
                <th>FIFA 积分</th>
                <th>Elo</th>
                <th>近期国家队</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% (rows || []).forEach(function (r) {
                var p = (r.wc2026Profile && typeof r.wc2026Profile === 'object' && !Array.isArray(r.wc2026Profile)) ? r.wc2026Profile : {};
                var fifa = (p.fifaRanking && typeof p.fifaRanking === 'object') ? p.fifaRanking : {};
                var elo = (p.worldFootballElo && typeof p.worldFootballElo === 'object') ? p.worldFootballElo : {};
                var ri = (p.recentInternational && typeof p.recentInternational === 'object') ? p.recentInternational : {};
                var sum = (ri.summary && typeof ri.summary === 'object') ? ri.summary : {};
                var played = typeof sum.played === 'number' ? sum.played : null;
                var wdl = (typeof sum.wins === 'number' || typeof sum.draws === 'number' || typeof sum.losses === 'number')
                  ? ((sum.wins != null ? sum.wins : '—') + '/' + (sum.draws != null ? sum.draws : '—') + '/' + (sum.losses != null ? sum.losses : '—'))
                  : '—';
                var gf = sum.goalsFor;
                var ga = sum.goalsAgainst;
                var goals = (typeof gf === 'number' && typeof ga === 'number') ? (gf + '-' + ga) : '—';
              %>
                <tr>
                  <td><%= r.wcGroup || '—' %></td>
                  <td><%= r.shortName || '—' %></td>
                  <td><%= r.nameCn %></td>
                  <td><%= r.nameEn || '—' %></td>
                  <td><small class="admin-muted"><%= r.externalId %></small></td>
                  <td><%= fifa.worldRank != null ? fifa.worldRank : '—' %></td>
                  <td><%= fifa.points != null ? fifa.points : '—' %></td>
                  <td><%= elo.rating != null ? elo.rating : (r.eloRating != null ? r.eloRating : '—') %></td>
                  <td style="font-size:0.8rem;white-space:nowrap;">
                    <% if (played != null) { %>
                      <%= played %> 场 <%= wdl %> · <%= goals %>
                    <% } else { %>—<% } %>
                  </td>
                  <td><a href="<%= avBase %>/worldcup2026-team-detail/<%= r.id %>">编辑</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
