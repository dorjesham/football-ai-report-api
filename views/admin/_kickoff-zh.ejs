<% 
  /** 开球时间：数据库存 UTC，此处统一为北京时间展示 */
  var d = typeof kickoff !== 'undefined' ? kickoff : null;
  var out = '—';
  if (d) {
    var x = new Date(d);
    if (!isNaN(x.getTime())) {
      out = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Shanghai',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(x);
    }
  }
  var wrap = typeof wrapSpan !== 'undefined' ? wrapSpan !== false : true;
%>
<% if (wrap) { %>
<span class="admin-kickoff" title="北京时间（数据源自 football-data 的 utcDate）"><%= out %></span>
<% } else { %><%= out %><% } %>
