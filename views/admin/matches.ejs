<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <%- include('_admin-theme') %>
</head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('_nav') %>
    <main class="admin-main">
      <h1 class="admin-page-title">比赛列表</h1>
      <p class="admin-page-sub">筛选与进入单场详情</p>

      <% var avBase = (typeof locals.adminViewPathPrefix !== 'undefined' && locals.adminViewPathPrefix) ? locals.adminViewPathPrefix : '/admin-view'; %>
      <p class="admin-muted" style="margin:0 0 1rem;">默认按开球时间升序。表中时间为<strong>北京时间</strong>（由库内 UTC 转换）。来源列与 <code>Match.dataSource</code> 一致：常见为 <strong>API_FOOTBALL</strong>（<code>af-f-*</code> 赛程同步）或 <strong>FOOTBALL_DATA</strong>；「演示」等为手工/其他来源。</p>

      <section class="admin-card">
        <h2 class="admin-card-title">筛选</h2>
        <form method="get" action="<%= avBase %>/matches" class="admin-form-row">
          <div><label>tournamentId</label><input name="tournamentId" value="<%= tournamentId %>" /></div>
          <div><label>seasonId</label><input name="seasonId" value="<%= seasonId %>" /></div>
          <div><label>status</label><input name="status" placeholder="SCHEDULED" value="<%= status %>" /></div>
          <div><label>排序</label><select name="sort"><option value="asc" <%= (locals.sort || 'asc') !== 'desc' ? 'selected' : '' %>>升序（临近在前）</option><option value="desc" <%= locals.sort === 'desc' ? 'selected' : '' %>>降序</option></select></div>
          <div><button type="submit" class="admin-btn">应用</button></div>
        </form>
      </section>

      <table class="admin-table">
        <thead>
          <tr>
            <th>时间</th>
            <th>对阵</th>
            <th>杯赛</th>
            <th>来源</th>
            <th>状态</th>
            <th>焦点</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><%- include('_kickoff-zh', { kickoff: r.kickoffTime }) %></td>
              <td>
                <div class="admin-match-teams">
                  <%- include('_team-block', { team: r.homeTeam }) %>
                  <span class="admin-vs">vs</span>
                  <%- include('_team-block', { team: r.awayTeam }) %>
                </div>
              </td>
              <td><%= r.competition && r.competition.code ? r.competition.code : '—' %><% if (r.competition) { %><br /><a style="font-size:0.75rem" href="<%= avBase %>/competitions/<%= r.competition.id %>/tools?seasonId=<%= encodeURIComponent(r.seasonId || '') %>">球队工具</a><% } %></td>
              <td><% if (r.dataSource === 'FOOTBALL_DATA') { %>FD<% } else { %><span style="color:var(--admin-warn)" title="演示数据">演示</span><% } %></td>
              <td><%= r.status %></td>
              <td><%= r.isFeatured ? '是' : '' %></td>
              <td><a href="<%= avBase %>/matches/<%= r.id %>">详情</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
