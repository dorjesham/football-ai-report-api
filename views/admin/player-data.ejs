<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <%- include('_admin-theme') %>
</head>
<body class="admin-body">
  <% var avBase = (typeof locals.adminViewPathPrefix !== 'undefined' && locals.adminViewPathPrefix) ? locals.adminViewPathPrefix : '/admin-view'; %>
  <% var eh = locals.envHints || {}; %>
  <% var aud = locals.audit || {}; %>
  <% var p = aud.players || {}; %>
  <% var teams = aud.teams || {}; %>
  <% var mf = aud.matchFacts || {}; %>
  <% var of = aud.openFootball || {}; %>
  <% var probe = of.defaultJsonProbe || {}; %>
  <% var jobs = aud.recentIngestJobsPlayerRelated || []; %>
  <div class="admin-layout">
    <%- include('_nav') %>
    <main class="admin-main" style="max-width:980px;">
      <h1 class="admin-page-title"><%= title %></h1>
      <p class="admin-page-sub">
        以 <strong>API-Football</strong> 同步<strong>赛程与球员名单</strong>为主（<code>profile.apiFootball</code>）；<strong>Football-Data</strong> 作<strong>辅助</strong>大名单与教练 enrich；<strong>OpenFootball</strong> 补历史赛程与比分；<strong>StatsBomb Open Data</strong> 可写入 <code>MatchFacts.rawStatsbomb</code>（<a href="<%= avBase %>/data-ingest#statsbomb-open-data">单场</a> · <a href="<%= avBase %>/data-ingest#statsbomb-batch">多季批量</a>）；<strong>FBref</strong> 支持 <strong>CSV 上传</strong> 合并 <code>profile.fbref</code>；<strong>Understat / Transfermarkt</strong> 仍为规划键。入库任务写入 <code>IngestJobRun</code>（含 <code>API_FOOTBALL_*</code> / <code>FD_PLAYER_SQUADS</code> / OpenFootball / <code>STATSBOMB_OPEN_DATA</code> / <code>STATSBOMB_OPEN_DATA_BATCH</code> / 审计）。
      </p>
      <p>
        <a class="admin-back" href="<%= avBase %>">← Dashboard</a>
        · <a href="<%= avBase %>/data-ingest#api-football">数据入库 · API-Football</a>
        · <a href="<%= avBase %>/data-ingest#fd-player-squads">FD squad / OpenFootball</a>
        · <a href="<%= avBase %>/data-ingest#statsbomb-batch">StatsBomb 批量</a>
      </p>

      <% if (locals.flashMsg) { %><p class="admin-flash-ok"><%= locals.flashMsg %></p><% } %>
      <% if (locals.flashErr) { %><p class="admin-flash-err"><%= locals.flashErr %></p><% } %>

      <section class="admin-card">
        <h2 class="admin-card-title">数据源对照（能力边界）</h2>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>来源</th>
                <th>入库方式</th>
                <th>实时性</th>
                <th>说明</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>API-Football</strong><br /><small class="admin-muted">api-sports.io v3</small></td>
                <td><a href="<%= avBase %>/data-ingest#api-football">数据入库</a> 表单：<code>/fixtures</code> + <code>/players</code> → <code>Player</code></td>
                <td>受免费版每日请求限制</td>
                <td class="admin-muted">主数据源；须先同步赛程再拉名单；<code>externalId</code> 形如 <code>af-p-*</code>。</td>
              </tr>
              <tr>
                <td><strong>OpenFootball</strong><br /><small class="admin-muted">football.json</small></td>
                <td>GitHub raw / Pages JSON，<strong>无 Key</strong>；本库「数据入库」③</td>
                <td>批量历史赛程与完赛比分</td>
                <td class="admin-muted">五大联赛等赛程与比分、球队 upsert；<strong>不含球员大名单</strong>。</td>
              </tr>
              <tr>
                <td><strong>Football-Data.org</strong></td>
                <td>REST <code>/teams/{id}</code> squad → <code>Player</code>；本页下方表单（辅）</td>
                <td>受免费额度限制（如每日次数）</td>
                <td class="admin-muted">大名单 + 可选 Person / 教练 enrich；与 API-Football 可并存对照。</td>
              </tr>
              <tr>
                <td><strong>FBref</strong></td>
                <td>本页 <strong>CSV 上传</strong> 或 <code>POST /admin/data-ingest/fbref/players-csv</code>（multipart）→ <code>profile.fbref.seasons[seasonTag]</code></td>
                <td>赛后统计为主，非低延迟</td>
                <td class="admin-muted">需表头含 <strong>Player</strong> 与 <strong>Squad</strong>（或 Team）；按 <code>competitionCode</code> 下历史 <code>Match</code> 出现过的主客队匹配球队，再按姓名匹配球员。建议先跑 <strong>API-Football 名单</strong> 或 FD squad 以便库内有球员行。遵守 FBref 使用条款。</td>
              </tr>
              <tr>
                <td><strong>Understat</strong></td>
                <td><strong>规划</strong>：页面解析 → <code>profile.understat</code></td>
                <td>延迟高</td>
                <td class="admin-muted">xG/xA 等进阶指标；不适合实时事件流。</td>
              </tr>
              <tr>
                <td><strong>Transfermarkt</strong></td>
                <td><strong>规划</strong>：遵守条款与节流 → <code>profile.transfermarkt</code></td>
                <td>非赛况实时</td>
                <td class="admin-muted">转会、身价、合同等维度，补充球员/俱乐部。</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="admin-muted" style="margin:0.75rem 0 0;font-size:0.78rem;">
          <span class="admin-pill <%= eh.hasApiFootballKey ? 'on' : 'off' %>">API-Football Key</span>
          <span class="admin-pill <%= eh.hasFootballDataKey ? 'on' : 'off' %>">FD API Key</span>
          主路径可在 <a href="<%= avBase %>/data-ingest">数据入库</a> 使用 API-Football 同步阵容（<code>profile.apiFootball</code>）。未配置 FD Key 时 FD squad 会失败；OpenFootball 仍可不依赖 Key 拉 JSON。
        </p>
      </section>

      <section class="admin-card">
        <h2 class="admin-card-title">FBref · 球员统计 CSV 上传解析</h2>
        <p class="admin-muted" style="margin:0 0 1rem;font-size:0.84rem;line-height:1.65;">
          从 FBref 导出「球员标准统计」等 <strong>UTF-8 CSV</strong>（常见多级表头会自动跳过，直至识别到同时含 <code>Player</code> 与 <code>Squad</code>/<code>Team</code> 的行）。请先在本赛事跑过 <strong>API-Football 名单</strong> 或 <strong>FD squad</strong> 以便库内有球员行可匹配。同一 <code>seasonTag</code> 再次上传将<strong>覆盖</strong>该季在 <code>profile.fbref.seasons[seasonTag]</code> 下的快照。
        </p>
        <form method="post" action="<%= avBase %>/player-data/actions/fbref-csv" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:0.85rem;max-width:520px;">
          <label style="display:flex;flex-direction:column;gap:0.25rem;">
            <span class="admin-muted" style="font-size:0.72rem;">CSV 文件（字段名必须为 <code>file</code>）</span>
            <input name="file" type="file" accept=".csv,text/csv" required style="font-size:0.85rem;" />
          </label>
          <label style="display:flex;flex-direction:column;gap:0.25rem;">
            <span class="admin-muted" style="font-size:0.72rem;">competitionCode（须与库内 <code>Competition.code</code> 一致，如 PL）</span>
            <input name="competitionCode" type="text" required placeholder="PL" style="padding:0.45rem;border-radius:8px;border:1px solid var(--admin-border);background:var(--admin-surface);color:var(--admin-text);" />
          </label>
          <label style="display:flex;flex-direction:column;gap:0.25rem;">
            <span class="admin-muted" style="font-size:0.72rem;">seasonTag（写入 <code>profile.fbref.seasons</code> 的键，如 2024-25）</span>
            <input name="seasonTag" type="text" required placeholder="2024-25" style="padding:0.45rem;border-radius:8px;border:1px solid var(--admin-border);background:var(--admin-surface);color:var(--admin-text);" />
          </label>
          <button type="submit" class="admin-btn" style="align-self:flex-start;">上传并入库</button>
        </form>
        <p class="admin-muted" style="margin:0.75rem 0 0;font-size:0.75rem;">
          REST（Admin JWT）：<code>POST /admin/data-ingest/fbref/players-csv</code>，<code>multipart/form-data</code>，字段 <code>file</code>、<code>competitionCode</code>、<code>seasonTag</code>。成功后会写入 <code>IngestJobRun</code>（<code>FBREF_PLAYERS_CSV</code>），并更新 <code>Player.fbrefStatsSyncedAt</code>、<code>fbrefSeasonTag</code>、<code>fbrefMinutes</code>（来自 Min 列）。
        </p>
      </section>

      <section class="admin-card">
        <h2 class="admin-card-title">库内审计（只读快照 + 可落库任务）</h2>
        <p class="admin-muted" style="margin:0 0 1rem;font-size:0.84rem;line-height:1.65;">
          打开本页时会刷新一次快照。点击下方按钮将再跑一遍并写入 <code>IngestJobRun</code>（<code>PLAYER_DATA_AUDIT</code>），便于与 FD / OpenFootball 任务对照时间线。
        </p>
        <form method="post" action="<%= avBase %>/player-data/actions/run-audit" style="margin-bottom:1rem;">
          <button type="submit" class="admin-btn">执行球员数据审计（写入 IngestJobRun）</button>
        </form>
        <div class="admin-grid-stats" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr));">
          <div class="admin-stat"><small>Player 总数</small><span><%= p.total != null ? p.total : '—' %></span></div>
          <div class="admin-stat"><small>有 externalId</small><span><%= p.withExternalId != null ? p.withExternalId : '—' %></span></div>
          <div class="admin-stat"><small>profile.fdSquad</small><span><%= p.withProfileFdSquad != null ? p.withProfileFdSquad : '—' %></span></div>
          <div class="admin-stat"><small>profile.fdPerson</small><span><%= p.withProfileFdPerson != null ? p.withProfileFdPerson : '—' %></span></div>
          <div class="admin-stat"><small>profile.fbref</small><span><%= p.withProfileFbref != null ? p.withProfileFbref : '—' %></span></div>
          <div class="admin-stat"><small>profile.understat</small><span><%= p.withProfileUnderstat != null ? p.withProfileUnderstat : '—' %></span></div>
          <div class="admin-stat"><small>profile.transfermarkt</small><span><%= p.withProfileTransfermarkt != null ? p.withProfileTransfermarkt : '—' %></span></div>
          <div class="admin-stat"><small>MatchFacts 含 lineups</small><span><%= mf.rowsWithLineupsJson != null ? mf.rowsWithLineupsJson : '—' %></span></div>
        </div>
        <% if (p.byDataSource && p.byDataSource.length) { %>
        <h3 class="admin-muted" style="margin:1rem 0 0.5rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;">Player.dataSource</h3>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>dataSource</th><th>数量</th></tr></thead>
            <tbody>
              <% p.byDataSource.forEach(function(row) { %>
                <tr><td><code><%= row.dataSource %></code></td><td><%= row.count %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
        <% if (teams.byDataSource && teams.byDataSource.length) { %>
        <h3 class="admin-muted" style="margin:1rem 0 0.5rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;">Team.dataSource</h3>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>dataSource</th><th>数量</th></tr></thead>
            <tbody>
              <% teams.byDataSource.forEach(function(row) { %>
                <tr><td><code><%= row.dataSource %></code></td><td><%= row.count %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
        <p class="admin-muted" style="margin:0.75rem 0 0;font-size:0.75rem;">
          OpenFootball 默认 en.1 探测：<strong><%= probe.ok ? '可达' : '失败' %></strong>
          <% if (probe.url) { %> · <code style="font-size:0.7rem;"><%= probe.url %></code><% } %>
          <% if (probe.status != null) { %> · HTTP <%= probe.status %><% } %>
          <% if (probe.error) { %> · <%= probe.error %><% } %>
        </p>
      </section>

      <section class="admin-card">
        <h2 class="admin-card-title">API-Football（主）· 球员名单</h2>
        <p class="admin-muted" style="margin:0 0 1rem;font-size:0.84rem;line-height:1.65;">
          与 <a href="<%= avBase %>/data-ingest#api-football">数据入库 · API-Football 球员名单</a> 同源（须先跑过 AF 赛程）。REST：<code>POST /admin/data-ingest/api-football/squads</code>（Admin JWT）。
        </p>
      </section>

      <section class="admin-card">
        <h2 class="admin-card-title">Football-Data（辅）· 球员 squad 入库（与数据入库页同源）</h2>
        <p class="admin-muted" style="margin:0 0 1rem;font-size:0.84rem;line-height:1.65;">
          与 <a href="<%= avBase %>/data-ingest#fd-player-squads">数据入库 ②</a> 相同接口：<code>POST <%= avBase %>/data-ingest/actions/fd-player-squads</code>。
        </p>
        <form method="post" action="<%= avBase %>/data-ingest/actions/fd-player-squads" style="display:flex;flex-direction:column;gap:0.85rem;">
          <fieldset style="border:1px solid var(--admin-border);border-radius:8px;padding:0.75rem 1rem;margin:0;">
            <legend style="font-size:0.75rem;color:var(--admin-muted);padding:0 0.35rem;">选择联赛（可多选；不选则默认五大联赛 + 欧冠）</legend>
            <div style="display:flex;flex-wrap:wrap;gap:0.65rem 1.25rem;margin-top:0.35rem;font-size:0.875rem;">
              <% [['PL','英超'],['PD','西甲'],['SA','意甲'],['BL1','德甲'],['FL1','法甲'],['CL','欧冠'],['WC','世界杯']].forEach(function(pair) { var code=pair[0],label=pair[1]; %>
                <label style="display:inline-flex;align-items:center;gap:0.35rem;cursor:pointer;">
                  <input type="checkbox" name="codes" value="<%= code %>" />
                  <span><%= code %> <%= label %></span>
                </label>
              <% }); %>
            </div>
          </fieldset>
          <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end;">
            <label style="display:flex;flex-direction:column;gap:0.25rem;">
              <span class="admin-muted" style="font-size:0.72rem;">球队请求间隔 ms</span>
              <input name="delayBetweenTeamMs" type="number" min="0" max="60000" value="900" style="width:8rem;padding:0.4rem;border-radius:6px;border:1px solid var(--admin-border);background:var(--admin-surface);color:var(--admin-text);" />
            </label>
            <label style="display:flex;flex-direction:column;gap:0.25rem;">
              <span class="admin-muted" style="font-size:0.72rem;">Person 间隔 ms</span>
              <input name="delayBetweenPersonMs" type="number" min="0" max="60000" value="350" style="width:8rem;padding:0.4rem;border-radius:6px;border:1px solid var(--admin-border);background:var(--admin-surface);color:var(--admin-text);" />
            </label>
            <label style="display:inline-flex;align-items:center;gap:0.45rem;font-size:0.85rem;cursor:pointer;">
              <input type="checkbox" name="enrichPerson" value="1" />
              <span>Person 增强（高配额）</span>
            </label>
            <label style="display:flex;flex-direction:column;gap:0.25rem;">
              <span class="admin-muted" style="font-size:0.72rem;">教练单场阵型样本 0～12</span>
              <input name="coachMatchDetailSample" type="number" min="0" max="12" value="5" style="width:8rem;padding:0.4rem;border-radius:6px;border:1px solid var(--admin-border);background:var(--admin-surface);color:var(--admin-text);" />
            </label>
            <label style="display:inline-flex;align-items:center;gap:0.45rem;font-size:0.85rem;cursor:pointer;">
              <input type="checkbox" name="skipCoachEnrich" value="1" />
              <span>跳过教练 enrich</span>
            </label>
            <label style="display:inline-flex;align-items:center;gap:0.45rem;font-size:0.85rem;cursor:pointer;">
              <input type="checkbox" name="skipTeamMeta" value="1" />
              <span>不写球队 venue 等 meta</span>
            </label>
            <button type="submit" class="admin-btn">执行球员 squad 入库</button>
          </div>
        </form>
        <p class="admin-muted" style="margin:0.75rem 0 0;font-size:0.75rem;">
          成功后可在下方任务列表或 <a href="<%= avBase %>/data-ingest">数据入库</a> 底部查看 <code>FD_PLAYER_SQUADS</code> 的 <code>resultSummary</code>。REST：<code>GET /admin/data-ingest/player-audit</code>、<code>POST /admin/data-ingest/player-audit/run</code>、<code>POST /admin/data-ingest/fbref/players-csv</code>（Admin JWT）。API-Football 任务 kind 为 <code>API_FOOTBALL_SQUADS</code>。
        </p>
      </section>

      <section class="admin-card">
        <h2 class="admin-card-title">近期球员相关入库任务</h2>
        <% if (!jobs.length) { %>
          <p class="admin-muted" style="margin:0;">暂无 API-Football / FD squad / OpenFootball 联赛 / FBref CSV / 审计任务记录。</p>
        <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>时间</th>
                <th>kind</th>
                <th>status</th>
                <th>备注</th>
              </tr>
            </thead>
            <tbody>
              <% jobs.forEach(function(j) { %>
                <tr>
                  <td class="admin-kickoff"><small class="admin-muted"><%= j.startedAt %></small></td>
                  <td><code><%= j.kind %></code><br /><small class="admin-muted"><%= j.id %></small></td>
                  <td><%= j.status %></td>
                  <td><% if (j.errorMessage) { %><span class="admin-flash-err" style="display:inline;padding:0.2rem 0.4rem;font-size:0.72rem;"><%= j.errorMessage.slice(0, 200) %></span><% } else { %>—<% } %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
