ADMIN_VIEW_LOGIN_PASSWORD=daoji123456

# 浏览器 CORS：与 README 公网 API origin 一致。启动脚本会覆盖平台误配的 CORS_ORIGIN=* / 空串。
# 若前端在其它域名，请在 Sealos 设为真实 https 源（非 *）；合法值不会被本文件覆盖。
# API=oaifjhzmpswi；前端 Web=oovxhxiusmdy（须同时允许前端跨域调 API）
CORS_ORIGIN=https://oovxhxiusmdy.sealosbja.site,https://oaifjhzmpswi.sealosbja.site
